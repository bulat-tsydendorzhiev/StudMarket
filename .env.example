# Shared PostgreSQL credentials (dev only)
POSTGRES_USER=studmarket
POSTGRES_PASSWORD=studmarket

# Databases
AUTH_DB_NAME=auth_db
LISTING_DB_NAME=listing_db
CHAT_DB_NAME=chat_db

# Exposed ports
NGINX_PORT=80

# Auth
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789

# Frontend: empty means same-origin (/api is proxied by nginx).
# Set an absolute URL only if the frontend is hosted separately.
VITE_API_URL=